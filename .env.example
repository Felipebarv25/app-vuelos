# Copia este archivo como  .env  y rellena tus datos reales.
# El archivo .env NUNCA debe subirse a internet ni a GitHub.

# === Travelpayouts (datos de vuelos) — https://www.travelpayouts.com ===
TRAVELPAYOUTS_TOKEN=tu_token_de_travelpayouts
# Opcional: tu "marker" de afiliado para ganar comisión por reservas
TRAVELPAYOUTS_MARKER=

# === Telegram (recomendado) ===
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === Correo por Gmail (opcional) ===
EMAIL_REMITENTE=tucorreo@gmail.com
EMAIL_PASSWORD=clave_de_aplicacion_de_16_letras
EMAIL_DESTINATARIO=tucorreo@gmail.com
